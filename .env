# ------------------------------
# Database Configuration
# ------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=pass
DB_NAME=bargo_db

# ------------------------------
# Retry Settings
# ------------------------------
DB_MAX_RETRIES=5

# ------------------------------
# HTTP Ports for Services
# ------------------------------
BUSINESS_HTTP_PORT=3000
CONSUMER_HTTP_PORT=3001
ADMIN_HTTP_PORT=3002
AUTH_HTTP_PORT=3003
WEB_HTTP_PORT=8080

# ------------------------------
# Application Settings
# ------------------------------
JWT_SECRET=GoldenFoxy_KeepOut!_!_xo

# ------------------------------
# Docker Container Defaults
# ------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
